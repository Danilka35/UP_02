<Page x:Class="ChitaiGorod.Pages.SpisokTovarsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ChitaiGorod.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SpisokTovarsPage" Background="White" Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="poiskSortFilterGrid" Grid.Row="0" Height="100">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Margin="30,0,0,0" Width="400">
                <TextBox x:Name="poiskSpisokTextBox" TextChanged="poiskSpisokTextBox_TextChanged" />
                <Grid>
                    <StackPanel HorizontalAlignment="Left">
                        <Label Content="Поле сортировки" />
                        <ComboBox x:Name="poleSortComboBox" SelectionChanged="poleSortComboBox_SelectionChanged" SelectedIndex="0">
                            <ComboBoxItem Content="Не выбрано"/>
                            <ComboBoxItem Content="Цена"/>
                            <ComboBoxItem Content="Количество на складе"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <Label Content="Сортировка по" />
                        <ComboBox x:Name="viborSortCmboBox" SelectionChanged="viborSortCmboBox_SelectionChanged" SelectedIndex="-1">
                            <ComboBoxItem Content="По возрастанию"/>
                            <ComboBoxItem Content="По убыванию"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right">
                        <Label Content="Фильтр по скидке" />
                        <ComboBox x:Name="filterSkidkaComboBox" SelectionChanged="filterSkidkaComboBox_SelectionChanged">
                            <ComboBoxItem Content="Все диапазоны"/>
                            <ComboBoxItem Content="0-12,99%"/>
                            <ComboBoxItem Content="13-16,99%"/>
                            <ComboBoxItem Content="более 17%"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <!--<StackPanel Orientation="Horizontal">
                    <StackPanel>
                        <Label Content="Поле сортировки" />
                        <ComboBox x:Name="sortComboBox"/>
                    </StackPanel>
                    <StackPanel>
                    </StackPanel>
                </StackPanel>-->
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,30,0" Orientation="Horizontal">
                <Button x:Name="addTovarButton" Content="Добавить товар" Padding="5" Margin="0,0,10,0" Click="addTovarButton_Click"/>
                <Button x:Name="openZakazsButton" Content="Заказы" Padding="5" Click="openZakazsButton_Click" />
            </StackPanel>

        </Grid>
        <ListView ScrollViewer.HorizontalScrollBarVisibility="Disabled" x:Name="tovarListView" Grid.Row="1" Margin="15">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="{Binding TovarBackground}" BorderBrush="Black" BorderThickness="1" Padding="10" Margin="0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" BorderBrush="Black" BorderThickness="1" Margin="0,0,10,0">
                                <Image Source="{Binding FullPhotoPath}" Stretch="Uniform" Height="120"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0">
                                <TextBlock FontWeight="Bold" FontSize="14" TextWrapping="Wrap">
                                    <Run Text="{Binding IdCategoryNavigation.Name}"/>
                                    <Run Text=" | "/>
                                    <Run Text="{Binding Name}"/>
                                </TextBlock>

                                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                                    <Run Text="Описание товара: "/>
                                    <Run Text="{Binding OpisanieTovar}"/>
                                </TextBlock>

                                <TextBlock>
                                    <Run Text="Производитель: "/>
                                    <Run Text="{Binding IdProizvoditelaNavigation.Name}"/>
                                </TextBlock>

                                <TextBlock>
                                    <Run Text="Поставщик: "/>
                                    <Run Text="{Binding IdPostavchikaNavigation.Name}"/>
                                </TextBlock>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Цена: "/>

                                    <TextBlock Text="{Binding Price, StringFormat={}{0:N2} руб.}" Foreground="Red" TextDecorations="Strikethrough" Visibility="{Binding SkidkaVisibility}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding FinalPrice, StringFormat={}{0:N2} руб.}" Foreground="Black"/>
                                </StackPanel>

                                <TextBlock>
                                    <Run Text="Единица измерения: "/>
                                    <Run Text="{Binding IdEdinicaIzmereniaNavigation.Name}"/>
                                </TextBlock>

                                <TextBlock>
                                    <Run Text="Количество на складе: "/>
                                    <Run Text="{Binding QuantityNaSklade}"/>
                                </TextBlock>
                            </StackPanel>

                            <Border Grid.Column="2" BorderBrush="Black" BorderThickness="1" Margin="10,0,0,0">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="Действующая&#x0a;скидка" TextAlignment="Center"/>
                                    <TextBlock Text="{Binding Skidka, StringFormat={}{0}%}" 
                                       FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
