<Page x:Class="ChitaiGorod.Pages.VhodPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ChitaiGorod.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="VhodPage" Background="White" Loaded="Page_Loaded">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Label Width="201" Content="Авторизация" />
            <Label Content="Логин" />
            <TextBox x:Name="loginTextBox" />
            <Label Content="Пароль" />
            <TextBox x:Name="passwordTextBox" />
            <Button x:Name="vhodButton" Content="Войти" Margin="0,20,0,0" Click="vhodButton_Click" />
            <Button x:Name="goastButton" Content="Войти гостем" Margin="0,10,0,0" />
        </StackPanel>
    </Grid>
</Page>
